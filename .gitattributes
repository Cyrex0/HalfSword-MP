# Normalise line endings in the repository; check out with the endings each tool needs.
* text=auto

# Unix shells and UE4SS-loaded Lua: always LF
*.sh        text eol=lf
.githooks/* text eol=lf
*.lua       text eol=lf
*.rs        text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile  text eol=lf

# Windows PowerShell: CRLF
*.ps1       text eol=crlf
*.psm1      text eol=crlf

# Binary
*.png  binary
*.jpg  binary
*.ico  binary
*.exe  binary
*.dll  binary
