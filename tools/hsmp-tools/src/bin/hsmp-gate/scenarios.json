     "ev": "lobby_ready",
     "who": "each",
     "timeout_s": 120
    },
    {
     "do": "quit_all"
    }
   ]
  },
  "soak_60m": {
   "doc": "Soak: 2 instances, ~60 min, 9 arena blocks x 10 rounds via RCON DEBUG KILL, every arena, netsim wifi + a 3 s blackout per round; 0 crashes, memory slope/growth bounded, 0 Lua errors, no hitch > 2 s",
   "dod": [1, 2, 3, 6, 12],
   "extra_rules": ["SOAK-CRASH", "SOAK-MEM", "SOAK-LUAERR", "SOAK-HITCH"],
   "topology": "dedicated",
   "netsim": "wifi",
   "arenas": ["Alley", "Pit", "Yard", "Slums", "Cellar", "LordsHall", "EastTower", "Alley", "Pit"],
   "rounds": 10,
   "requires": ["debug_verbs", "mem_sampler", "crash_triage"],
   "soak": {
    "duration_min": 60,
    "mem_sample_s": 30,
    "mem_warmup_min": 10,
    "mem_min_samples": 20,
    "mem_slope_max_mb_per_h": 150,
    "mem_growth_max_mb": 400,
    "handle_slope_max_per_h": 500,
    "aux_mem_slope_max_mb_per_h": 20,
    "hitch_max_ms": 2000,
    "lua_errors_max": 0,
    "lua_error_allow": [],
    "crashes_max": 0
   },
   "steps": [
    { "do": "mark", "name": "boot" },
    { "do": "wait", "ev": "lobby_ready", "who": "each", "timeout_s": 150 },
    { "do": "wait", "ev": "cmd_result", "who": "each", "where": { "cmd": "ready", "ok": "true" }, "timeout_s": 30 },
    {
     "foreach_arena": [
      { "do": "mark", "name": "arena:{arena}" },
      { "do": "rcon", "cmd": "BESTOF {best_of}", "optional": true },
      { "do": "rcon", "cmd": "MAP {arena}", "pick": "{arena}" },
      { "do": "mark", "name": "start", "arena": "{arena}" },
      { "do": "rcon", "cmd": "START" },
      {
       "foreach_round": [
        { "do": "wait", "ev": "ready_report", "who": "each", "timeout_s": 120 },
        { "do": "wait", "ev": "phase", "who": "server", "where": { "to": "Live" }, "timeout_s": 60 },
        { "do": "hold", "s": 12, "why": "soak: fight under wifi" },
        { "do": "netsim", "inst": "{seat}", "mode": "blackout" },
        { "do": "hold", "s": 3, "why": "soak: blackout burst" },
        { "do": "netsim", "inst": "{seat}", "mode": "normal" },
        { "do": "hold", "s": 12, "why": "soak: recover + fight" },
        { "do": "rcon", "cmd": "DEBUG KILL {seat}" },
        { "do": "wait", "ev": "phase", "who": "server", "where": { "to": "RoundOver" }, "timeout_s": 30 },
        { "do": "mark", "name": "round_end", "round": "{round}" }
       ]
      },
      { "do": "rcon", "cmd": "ABORT" },
      { "do": "wait", "ev": "phase", "who": "server", "where": { "to": "Lobby" }, "timeout_s": 60 },
      { "do": "wait", "ev": "lobby_ready", "who": "each", "timeout_s": 120 },
      { "do": "wait", "ev": "cmd_result", "who": "each", "where": { "cmd": "ready", "ok": "true" }, "timeout_s": 30 }
     ]
    },
    { "do": "quit_all" }
   ]
  },
  "soak_10m": {
   "doc": "Quick soak (~10 min): soak_60m's round loop on Alley + Pit x 7 rounds; same rules, 3 min memory warm-up, 15 s samples",
   "dod": [1, 2, 3, 6, 12],
   "extra_rules": ["SOAK-CRASH", "SOAK-MEM", "SOAK-LUAERR", "SOAK-HITCH"],
   "topology": "dedicated",
   "netsim": "wifi",
   "arenas": ["Alley", "Pit"],
   "rounds": 7,
   "requires": ["debug_verbs", "mem_sampler", "crash_triage"],
   "soak": {
    "duration_min": 10,
    "mem_sample_s": 15,
    "mem_warmup_min": 3,
    "mem_min_samples": 12,
    "mem_slope_max_mb_per_h": 150,
    "mem_growth_max_mb": 400,
    "handle_slope_max_per_h": 500,
    "aux_mem_slope_max_mb_per_h": 20,
    "hitch_max_ms": 2000,
    "lua_errors_max": 0,
    "lua_error_allow": [],
    "crashes_max": 0
   },
   "steps": "soak_60m"
  },
  "p0_smoke_autotest": {
   "doc": "STOPGAP: legacy HSMP_AUTOTEST host/join, one match observed (no RCON driving)",
   "extra_rules": ["POSE-1"],
   "dod": [
    1,
    2,
    3,
    5,
    6,
    7,
    8,
    12
   ],
   "topology": "listen",
   "netsim": "typical",
