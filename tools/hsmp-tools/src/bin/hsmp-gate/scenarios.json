     "who": "server",
     "where": {
      "to": "Live"
     },
     "timeout_s": 240
    },
    {
     "do": "mark",
     "name": "live"
    },
    {
     "do": "hold",
     "s": 60,
     "why": "STOPGAP observation window (no RCON to end rounds)"
    },
    {
     "do": "quit_all"
    }
   ]
  }
 }
}